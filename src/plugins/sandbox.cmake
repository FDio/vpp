

message("hello")

FILE(GLOB files RELATIVE
  ${CMAKE_CURRENT_SOURCE_DIR}
  ${CMAKE_CURRENT_SOURCE_DIR}/*/CMakeLists.txt
)

function(_vpp_scan_one file rootdir outvar)
  set(_records "")
  macro(add_vpp_plugin)
    cmake_parse_arguments(V "" "" "DEPS PLATFORMS ARCHS" ${ARGV})
    set(_name "")
    set(_deps      "${V_DEPS}")
    set(_platforms "${V_PLATFORMS}")
    set(_archs     "${V_ARCHS}")
    list(JOIN _deps ";" _deps_join)
    list(JOIN _platforms ";" _plats_join)
    list(JOIN _archs ";" _archs_join)
    list(APPEND _records "${_name}|${_rel}|${_deps_join}|${_plats_join}|${_archs_join}")
  endmacro()
  macro(add_vpp_library)
  endmacro()
  macro(add_vpp_executable)
  endmacro()
  macro(vpp_find_path)
  endmacro()
  macro(vpp_plugin_find_library)
  endmacro()

  function(include_directories)
  endfunction()
  function(add_compile_definitions)
  endfunction()
  function(add_library)
  endfunction()
  function(add_executable)
  endfunction()
  function(target_link_libraries)
  endfunction()
  function(target_include_directories)
  endfunction()
  function(target_compile_definitions)
  endfunction()
  function(target_compile_options)
  endfunction()
  function(target_link_options)
  endfunction()
  function(add_custom_command)
  endfunction()
  function(add_custom_target)
  endfunction()
  function(install)
  endfunction()
  function(try_compile)
  endfunction()
  function(add_subdirectory)
  endfunction()
  function(set_target_properties)
  endfunction()
  include("${file}")
  set(${outvar} "${_records}" PARENT_SCOPE)
endfunction()

set(plugin_registry "")
foreach(f ${files})
  cmake_language(CALL _vpp_scan_one "${f}" "${ROOT_DIR}" r)
  message(WARNING  "--- ${f} -> ${r}")
  list(APPEND plugin_registry ${r})
endforeach()
