option version = "1.0.2";
import "vnet/ip/ip_types.api";
import "vnet/sfdp/sfdp_types.api";

typedef sfdp_per_thread_data
{
  u32 thread_index;
  u32 session_active;
  u32 session_in_freelist;
};

/** \brief
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param tenant_id - tenant id to add
    @param context_id - context id for this tenant (optional, default to same as tenant id)
    @param is_del
*/

autoreply define sfdp_tenant_add_del
{
  u32 client_index;
  u32 context;

  u32 tenant_id;
  u32 context_id [default=0xffffffff];
  bool is_del;
};

autoreply define sfdp_set_services
{
  u32 client_index;
  u32 context;

  u32 tenant_id;
  vl_api_sfdp_session_direction_t dir;
  u8 n_services;
  vl_api_sfdp_service_name_t services[n_services];
};

/** \brief Get SFDP infrastructure status */
define sfdp_status
{
  u32 client_index;
  u32 context;
};

/** \brief SFDP infrastructure status
    @param is_initialized - sfdp infrastructure has been initialized
    @param tenant_active - current number of tenant entries
    @param tenant_capacity - configured maximum number of tenants
    @param session_active - active sessions across all threads
    @param session_capacity - configured total number of session slots
    @param session_global_free - free session slots outside thread caches
    @param n_threads - number of per-thread status entries, including VPP main
    @param per_thread_data - per-thread active session and cache status
*/
define sfdp_status_reply
{
  u32 context;
  i32 retval;

  bool is_initialized;
  u64 tenant_capacity;
  u64 session_capacity;
  u64 session_active;
  u64 session_global_free;
  u32 tenant_active;
  u32 n_threads;
  vl_api_sfdp_per_thread_data_t per_thread_data[n_threads];
};

define sfdp_session_dump
{
  u32 client_index;
  u32 context;
};

define sfdp_session_details
{
  u32 context;

  u64 session_id;
  u32 thread_index;
  u32 tenant_id;
  u32 session_idx;
  vl_api_sfdp_session_type_t session_type;
  vl_api_ip_proto_t protocol;
  vl_api_sfdp_session_state_t state;
  f64 remaining_time;
/* Avoid service strings to keep it compact */
  u64 forward_bitmap;
  u64 reverse_bitmap;
  u8 n_keys;
  vl_api_sfdp_session_key_t keys[n_keys];
};

autoreply define sfdp_kill_session
{
  u32 client_index;
  u32 context;

  u32 session_index;
  bool is_all;
};

/** \brief Force expiry while inspecting up to the specified number of active
    sfdp sessions
    @param max - maximum number of active sfdp sessions to inspect.
*/
autoreply define sfdp_kill_session_batch
{
  u32 client_index;
  u32 context;

  u32 max [default=1000];
};

define sfdp_tenant_dump
{
  u32 client_index;
  u32 context;
};

define sfdp_tenant_details
{
  u32 context;

  u32 index;
  u32 context_id;
  u64 forward_bitmap;
  u64 reverse_bitmap;
  u32 n_timeout;
  u32 timeout[n_timeout];
};

define sfdp_timeout_dump
{
  u32 client_index;
  u32 context;

  u32 tenant_id [default=0xffffffff];
};

define sfdp_timeout_details
{
  u32 context;

  u32 index;
  string name[32];
  u32 timeout_value;
};

autoreply define sfdp_set_timeout
{
  u32 client_index;
  u32 context;

  u32 tenant_id;
  u32 timeout_value;
  u32 timeout_id;
};

autoreply define sfdp_set_sp_node
{
  u32 client_index;
  u32 context;

  u32 tenant_id;
  vl_api_sfdp_sp_node_t sp_node;
  u32 node_index;
};

autoreply define sfdp_set_icmp_error_node
{
  u32 client_index;
  u32 context;

  u32 tenant_id;
  bool is_ip6;
  u32 node_index;
};

define sfdp_service_dump
{
  u32 client_index;
  u32 context;
};

define sfdp_service_details
{
  u32 context;

  string node_name[32];
  string scope[32];
  bool is_terminal;
  u8 index;
};

/*
 * Local Variables:
 * eval: (c-set-style "gnu")
 * End:
 */
