      },
      "writtenOn": "2026-10-12T08:40:15Z",
      "side": 1,
      "message": "How does this classifier differ from the existing ACL implementation, and what prevents reusing or improving ACL as a service for this use case? It already provides stateless, mask-based hash lookup through lookup contexts. Could the additional FlowSpec fields and incremental updates be supported there? Are there comparative measurements showing where a separate implementation is needed?",
      "revId": "f8354c8fcf7bc31d703982c68821f4f513fe61ed",
      "serverId": "6d2eb258-4fe2-443e-8a38-ca81da23d4c2"
    }
