+static int
+nvmf_tcp_req_reserve_c2h(struct spdk_nvmf_tcp_req *tcp_req, uint32_t data_len)
+{
+	struct spdk_nvmf_tcp_qpair *tqpair = SPDK_CONTAINEROF(tcp_req->req.qpair,
+							struct spdk_nvmf_tcp_qpair, qpair);
+	struct spdk_nvmf_tcp_transport *ttransport = SPDK_CONTAINEROF(
+			tqpair->qpair.transport, struct spdk_nvmf_tcp_transport, transport);
+	struct spdk_nvmf_request *req = &tcp_req->req;
+	uint32_t alignment, data_offset, reservation_len, skip, remaining;
+	int i, rc, tx_iovcnt, req_iovcnt = 0;
+
+	/* First functional step: use a single C2H PDU without DIF or digests.
+	 * Other configurations retain the normal SPDK iobuf path. */
+	if (!ttransport->tcp_opts.c2h_direct_sock ||
+	    req->xfer != SPDK_NVME_DATA_CONTROLLER_TO_HOST || tqpair->qpair.qid == 0 ||
+	    req->dif_enabled || tqpair->host_hdgst_enable || tqpair->host_ddgst_enable) {
+		return -ENOTSUP;
+	}
+
+	data_offset = sizeof(struct spdk_nvme_tcp_c2h_data_hdr);
+	if (tqpair->cpda) {
+		alignment = (tqpair->cpda + 1) << 2;
+		data_offset = SPDK_ALIGN_CEIL(data_offset, alignment);
+	}
+	if (data_len > UINT32_MAX - data_offset) {
+		return -E2BIG;
+	}
+	reservation_len = data_offset + data_len;
+	if (!ttransport->tcp_opts.c2h_success) {
+		if (reservation_len > UINT32_MAX - sizeof(struct spdk_nvme_tcp_rsp)) {
+			return -E2BIG;
+		}
+		reservation_len += sizeof(struct spdk_nvme_tcp_rsp);
+	}
+	tx_iovcnt = SPDK_COUNTOF(tcp_req->tx_iov);
+	rc = spdk_sock_tx_reserve(tqpair->sock, reservation_len,
+				  tcp_req->tx_iov, &tx_iovcnt, &tcp_req->tx_reservation);
+	if (rc != 0) {
+		return rc;
+	}
+
+	/* Expose only the payload portion of the reservation to the bdev. */
+	skip = data_offset;
+	remaining = data_len;
+	for (i = 0; i < tx_iovcnt && remaining > 0; i++) {
+		uint8_t *base = tcp_req->tx_iov[i].iov_base;
+		uint32_t len = tcp_req->tx_iov[i].iov_len;
+
+		if (skip >= len) {
+			skip -= len;
+			continue;
+		}
+
+		if (req_iovcnt == NVMF_REQ_MAX_BUFFERS) {
+			rc = -ENOBUFS;
+			goto abort;
+		}
+
+		base += skip;
+		len -= skip;
+		skip = 0;
+		len = spdk_min(len, remaining);
+		req->iov[req_iovcnt].iov_base = base;
+		req->iov[req_iovcnt].iov_len = len;
+		req_iovcnt++;
+		remaining -= len;
+	}
+	if (remaining != 0) {
+		rc = -ENOBUFS;
+		goto abort;
+	}
+
+	req->iovcnt = req_iovcnt;
+	req->data_from_pool = false;
+	tcp_req->tx_iovcnt = tx_iovcnt;
+	tcp_req->tx_data_offset = data_offset;
+	tcp_req->tx_reservation_len = reservation_len;
+	return 0;
+
+abort:
+	if (spdk_sock_tx_abort(tqpair->sock, tcp_req->tx_reservation) != 0) {
+		nvmf_tcp_qpair_set_recv_state(tqpair, NVME_TCP_PDU_RECV_STATE_QUIESCING);
+	}
+	tcp_req->tx_reservation = NULL;
+	return rc;
+}
+
 static void
 nvmf_tcp_req_parse_sgl(struct spdk_nvmf_tcp_req *tcp_req,
 		       struct spdk_nvmf_transport *transport,
@@ -2727,6 +2835,14 @@ nvmf_tcp_req_parse_sgl(struct spdk_nvmf_tcp_req *tcp_req,
 			req->dif.elba_length = length;
 		}
 
+		if (nvmf_tcp_req_reserve_c2h(tcp_req, length) == 0) {
+			nvmf_tcp_req_set_state(tcp_req, TCP_REQUEST_STATE_HAVE_BUFFER);
+			SPDK_DEBUGLOG(nvmf_tcp,
+				      "Request %p uses %u direct socket TX buffer(s), data=%p\n",
+				      tcp_req, req->iovcnt, req->iov[0].iov_base);
+			return;
+		}
+
 		if (nvmf_ctrlr_use_zcopy(req)) {
 			SPDK_DEBUGLOG(nvmf_tcp, "Using zero-copy to execute request %p\n", tcp_req);
 			req->data_from_pool = false;
@@ -2854,6 +2970,120 @@ nvmf_tcp_dif_error_to_compl_status(uint8_t err_type) {
 	return result;
 }
 
+static int
+nvmf_tcp_req_abort_tx_reservation(struct spdk_nvmf_tcp_req *tcp_req)
+{
+	struct spdk_nvmf_tcp_qpair *tqpair;
+	int rc;
+
+	if (tcp_req->tx_reservation == NULL) {
+		return 0;
+	}
+
+	tqpair = SPDK_CONTAINEROF(tcp_req->req.qpair, struct spdk_nvmf_tcp_qpair, qpair);
+	rc = spdk_sock_tx_abort(tqpair->sock, tcp_req->tx_reservation);
+	tcp_req->tx_reservation = NULL;
+	tcp_req->tx_iovcnt = 0;
+	return rc;
+}
+
+static int
+nvmf_tcp_req_copy_tx(struct spdk_nvmf_tcp_req *tcp_req, uint32_t offset,
+		     const void *src, uint32_t len)
+{
+	const uint8_t *input = src;
+	uint32_t copied = 0;
+	int i;
+
+	for (i = 0; i < tcp_req->tx_iovcnt && copied < len; i++) {
+		uint8_t *output = tcp_req->tx_iov[i].iov_base;
+		uint32_t iov_len = tcp_req->tx_iov[i].iov_len;
+		uint32_t count;
+
+		if (offset >= iov_len) {
+			offset -= iov_len;
+			continue;
+		}
+		output += offset;
+		iov_len -= offset;
+		offset = 0;
+		count = spdk_min(iov_len, len - copied);
+
+		if (input != NULL) {
+			memcpy(output, input + copied, count);
+		} else {
+			memset(output, 0, count);
+		}
+		copied += count;
+	}
+
+	return copied == len ? 0 : -ENOBUFS;
+}
+
+static int
+nvmf_tcp_send_reserved_c2h_data(struct spdk_nvmf_tcp_qpair *tqpair,
+				struct spdk_nvmf_tcp_req *tcp_req)
+{
+	struct nvme_tcp_pdu *rsp_pdu;
+	struct spdk_nvme_tcp_c2h_data_hdr *c2h_data;
+	struct spdk_nvme_tcp_rsp capsule_resp = {};
+	struct spdk_nvmf_tcp_transport *ttransport = SPDK_CONTAINEROF(
+			tqpair->qpair.transport, struct spdk_nvmf_tcp_transport, transport);
+	uint32_t c2h_plen;
+	int rc;
+
+	assert(tcp_req->tx_reservation != NULL);
+	assert(!tqpair->host_hdgst_enable && !tqpair->host_ddgst_enable);
+
+	rsp_pdu = nvmf_tcp_req_pdu_init(tcp_req);
+	c2h_data = &rsp_pdu->hdr.c2h_data;
+	c2h_data->common.pdu_type = SPDK_NVME_TCP_PDU_TYPE_C2H_DATA;
+	c2h_data->common.hlen = sizeof(*c2h_data);
+	c2h_data->common.pdo = tcp_req->tx_data_offset;
+	c2h_plen = tcp_req->tx_data_offset + tcp_req->req.length;
+	c2h_data->common.plen = c2h_plen;
+	c2h_data->common.flags = SPDK_NVME_TCP_C2H_DATA_FLAGS_LAST_PDU;
+	if (ttransport->tcp_opts.c2h_success) {
+		c2h_data->common.flags |= SPDK_NVME_TCP_C2H_DATA_FLAGS_SUCCESS;
+	}
+	c2h_data->cccid = tcp_req->req.cmd->nvme_cmd.cid;
+	c2h_data->datao = 0;
+	c2h_data->datal = tcp_req->req.length;
+
+	rsp_pdu->rw_offset = tcp_req->req.length;
+	rc = nvmf_tcp_req_copy_tx(tcp_req, 0, NULL, tcp_req->tx_data_offset);
+	if (rc == 0) {
+		rc = nvmf_tcp_req_copy_tx(tcp_req, 0, c2h_data, sizeof(*c2h_data));
+	}
+	if (rc == 0 && !ttransport->tcp_opts.c2h_success) {
+		capsule_resp.common.pdu_type = SPDK_NVME_TCP_PDU_TYPE_CAPSULE_RESP;
+		capsule_resp.common.plen = capsule_resp.common.hlen = sizeof(capsule_resp);
+		capsule_resp.rccqe = tcp_req->req.rsp->nvme_cpl;
+		rc = nvmf_tcp_req_copy_tx(tcp_req, c2h_plen, &capsule_resp,
+					  sizeof(capsule_resp));
+	}
+	if (rc == 0) {
+		rc = spdk_sock_tx_commit(tqpair->sock, tcp_req->tx_reservation);
+	}
+
+	if (rc != 0) {
+		SPDK_ERRLOG("Failed to commit direct C2H transmit buffers: %d\n", rc);
+		if (nvmf_tcp_req_abort_tx_reservation(tcp_req) != 0) {
+			nvmf_tcp_qpair_set_recv_state(tqpair, NVME_TCP_PDU_RECV_STATE_QUIESCING);
+		}
+		return rc;
+	}
+
+	tcp_req->tx_reservation = NULL;
+	tcp_req->tx_iovcnt = 0;
+	if (ttransport->tcp_opts.c2h_success) {
+		nvmf_tcp_pdu_c2h_data_complete(tcp_req);
+	} else {
+		nvmf_tcp_request_free(tcp_req);
+	}
+	return 0;
+}
+
 static void
 _nvmf_tcp_send_c2h_data(struct spdk_nvmf_tcp_qpair *tqpair,
 			struct spdk_nvmf_tcp_req *tcp_req)
@@ -3007,8 +3237,18 @@ request_transfer_out(struct spdk_nvmf_request *req)
