From bec97fa1795fe62798605e32266078a3e88055e8 Mon Sep 17 00:00:00 2001
From: Ben Walker <ben@nvidia.com>
Date: Fri, 6 Sep 2024 14:31:48 -0700
Subject: [PATCH 04/15] sock: Add new zero copy API

This API has the sock modules own buffer allocation. The upper layer
simply does a recv_next, then later returns the buffer.

Also fix a pre-existing bug in spdk_sock_group_close() where
group_impl_close was called while the group_impl was still on the list.

Change-Id: Ie90337b4873d7b870bd25b4be96d1fb24f3710d9
Signed-off-by: Ben Walker <ben@nvidia.com>
---
 include/spdk/sock.h                 |  51 ++++++++++++
 include/spdk_internal/sock_module.h |   8 ++
 lib/sock/sock.c                     |  48 +++++++++++
 lib/sock/spdk_sock.map              |   3 +
 test/common/lib/test_sock.c         |  18 +++++
 test/unit/lib/sock/sock.c/sock_ut.c | 118 ++++++++++++++++++++++++++++
 6 files changed, 246 insertions(+)

diff --git a/include/spdk/sock.h b/include/spdk/sock.h
index af909339d..5beefc550 100644
--- a/include/spdk/sock.h
+++ b/include/spdk/sock.h
@@ -540,6 +540,57 @@ void spdk_sock_writev_async_ext(struct spdk_sock *sock, struct spdk_sock_request
  */
 ssize_t spdk_sock_readv(struct spdk_sock *sock, struct iovec *iov, int iovcnt);
 
+struct spdk_sock_buf_token;
+
+/**
+ * Receive the next portion of the stream from the socket.
+ *
+ * Callers must first check support using spdk_sock_impl_supports_recv_next(),
+ * or select a socket implementation known to support this operation.
+ *
+ * The buffer pointed to by `buf` must later be returned by calling
+ * `spdk_sock_group_release_buf()`.
+ *
+ * Note that the amount of data in buf is determined entirely by
+ * the sock layer. You cannot request to receive only a limited
+ * amount here. You simply get whatever the next portion of the stream
+ * is, as determined by the sock module.
+ *
+ * \param sock Socket to receive from.
+ * \param buf Populated with the next portion of the stream
+ * \param token Populated with the token for the buffer
+ *
+ * \return On success, the length of the buffer placed into buf. Zero means no buffer is
+ * available now. On failure, returns a negative errno value.
+ */
+int spdk_sock_recv_next(struct spdk_sock *sock, void **buf, struct spdk_sock_buf_token **token);
+
+/**
+ * Check whether a socket implementation supports spdk_sock_recv_next().
+ *
+ * \param impl_name The socket implementation to check, or NULL for the current default.
+ *
+ * \return true if the implementation supports spdk_sock_recv_next().
+ */
+bool spdk_sock_impl_supports_recv_next(const char *impl_name);
+
+/**
+ * Release a buffer obtained via spdk_sock_recv_next() back to the receive pool of the
+ * group that owns it, identified by the group rather than the socket it was received on.
+ *
+ * The buffer pool is owned by the group, not the socket, so buffers can be released after
+ * their socket has been closed (e.g. during qpair teardown).
+ * The group must remain open until all of its buffers have been released.
+ *
+ * \param group Socket group that owns the buffer pool.
+ * \param buf Pointer to the buffer.
+ * \param token Token for the buffer.
+ *
+ * \return 0 on success, negative errno on failure.
+ */
+int spdk_sock_group_release_buf(struct spdk_sock_group *group, void *buf,
+				struct spdk_sock_buf_token *token);
+
 /**
  * Set the value used to specify the low water mark (in bytes) for this socket.
  *
diff --git a/include/spdk_internal/sock_module.h b/include/spdk_internal/sock_module.h
index 9b8e95e10..f7e74526e 100644
--- a/include/spdk_internal/sock_module.h
+++ b/include/spdk_internal/sock_module.h
@@ -64,6 +64,11 @@ struct spdk_sock_group_impl {
 	STAILQ_ENTRY(spdk_sock_group_impl)	link;
 };
 
+/* Embedded in module-owned buffers; valid until the buffer is released. */
+struct spdk_sock_buf_token {
+	struct spdk_sock_group_impl *group_impl;
+};
+
 struct spdk_sock_map {
 	STAILQ_HEAD(, spdk_sock_placement_id_entry) entries;
 	pthread_mutex_t mtx;
@@ -86,6 +91,7 @@ struct spdk_net_impl {
 	ssize_t (*readv)(struct spdk_sock *sock, struct iovec *iov, int iovcnt);
 	ssize_t (*writev)(struct spdk_sock *sock, struct iovec *iov, int iovcnt);
 
+	int (*recv_next)(struct spdk_sock *sock, void **buf, struct spdk_sock_buf_token **token);
 	void (*writev_async)(struct spdk_sock *sock, struct spdk_sock_request *req);
 	void (*writev_async_ext)(struct spdk_sock *sock, struct spdk_sock_request *req,
 				 const struct spdk_sock_request_opts *opts);
@@ -109,6 +115,8 @@ struct spdk_net_impl {
 			       struct spdk_sock **socks);
 	int (*group_impl_get_interruptfd)(struct spdk_sock_group_impl *group);
 	int (*group_impl_close)(struct spdk_sock_group_impl *group);
+	int (*group_impl_release_buf)(struct spdk_sock_group_impl *group, void *buf,
+				      struct spdk_sock_buf_token *token);
 
 	int (*get_opts)(struct spdk_sock_impl_opts *opts, size_t *len);
 	int (*set_opts)(const struct spdk_sock_impl_opts *opts, size_t len);
diff --git a/lib/sock/sock.c b/lib/sock/sock.c
index b3ac3825e..b14e91aff 100644
--- a/lib/sock/sock.c
+++ b/lib/sock/sock.c
@@ -8,6 +8,7 @@
 
 #include "spdk/sock.h"
 #include "spdk_internal/sock_module.h"
+#include "spdk/likely.h"
 #include "spdk/log.h"
 #include "spdk/env.h"
 #include "spdk/util.h"
@@ -854,6 +855,52 @@ spdk_sock_readv(struct spdk_sock *sock, struct iovec *iov, int iovcnt)
 	return sock->net_impl->readv(sock, iov, iovcnt);
 }
 
+int
+spdk_sock_recv_next(struct spdk_sock *sock, void **buf, struct spdk_sock_buf_token **token)
+{
+	if (sock == NULL || sock->flags.closed) {
+		return -EBADF;
+	}
+
+	assert(sock->net_impl->recv_next != NULL);
+
+	return sock->net_impl->recv_next(sock, buf, token);
+}
+
+bool
+spdk_sock_impl_supports_recv_next(const char *impl_name)
+{
+	struct spdk_net_impl *impl;
+
+	if (impl_name == NULL) {
+		impl = g_default_impl;
+	} else {
+		impl = spdk_net_impl_get_by_name(impl_name);
+	}
+
+	return impl != NULL && impl->recv_next != NULL &&
+	       impl->group_impl_release_buf != NULL;
+}
+
+int
+spdk_sock_group_release_buf(struct spdk_sock_group *group, void *buf,
+			    struct spdk_sock_buf_token *token)
+{
+	struct spdk_sock_group_impl *group_impl;
+
+	if (group == NULL || token == NULL) {
+		return -EINVAL;
+	}
+
+	group_impl = token->group_impl;
+	if (group_impl == NULL || group_impl->group != group) {
+		return -EINVAL;
+	}
+
+	assert(group_impl->net_impl->group_impl_release_buf != NULL);
+	return group_impl->net_impl->group_impl_release_buf(group_impl, buf, token);
+}
+
 ssize_t
 spdk_sock_writev(struct spdk_sock *sock, struct iovec *iov, int iovcnt)
 {
@@ -1175,6 +1222,7 @@ spdk_sock_group_close(struct spdk_sock_group **_group)
 			}
 		}
 
+		STAILQ_REMOVE_HEAD(&group->group_impls, link);
 		rc = group_impl->net_impl->group_impl_close(group_impl);
 		if (rc != 0) {
 			SPDK_ERRLOG("group_impl_close for net failed\n");
diff --git a/lib/sock/spdk_sock.map b/lib/sock/spdk_sock.map
index b6735a695..95b585027 100644
--- a/lib/sock/spdk_sock.map
+++ b/lib/sock/spdk_sock.map
@@ -15,6 +15,9 @@
 	spdk_sock_close;
 	spdk_sock_flush;
 	spdk_sock_recv;
+	spdk_sock_recv_next;
+	spdk_sock_impl_supports_recv_next;
+	spdk_sock_group_release_buf;
 	spdk_sock_writev;
 	spdk_sock_writev_async;
 	spdk_sock_writev_async_ext;
diff --git a/test/common/lib/test_sock.c b/test/common/lib/test_sock.c
index 358ccdc13..d0a20ed51 100644
--- a/test/common/lib/test_sock.c
+++ b/test/common/lib/test_sock.c
@@ -34,6 +34,24 @@ DEFINE_STUB(spdk_sock_flush, int, (struct spdk_sock *sock), 0);
 DEFINE_STUB(spdk_sock_is_ipv6, bool, (struct spdk_sock *sock), false);
 DEFINE_STUB(spdk_sock_is_ipv4, bool, (struct spdk_sock *sock), true);
 DEFINE_STUB(spdk_sock_is_connected, bool, (struct spdk_sock *sock), true);
+DEFINE_STUB(spdk_sock_group_release_buf, int, (struct spdk_sock_group *group, void *buf,
+		struct spdk_sock_buf_token *token), 0);
+DEFINE_STUB(spdk_sock_get_default_impl, const char *, (void), "posix");
+DEFINE_STUB(spdk_sock_impl_supports_recv_next, bool, (const char *impl_name), false);
+
+static uint8_t g_buf[0x1000] = {};
+
+DEFINE_RETURN_MOCK(spdk_sock_recv_next, int);
+int
+spdk_sock_recv_next(struct spdk_sock *sock, void **buf, struct spdk_sock_buf_token **token)
+{
+	HANDLE_RETURN_MOCK(spdk_sock_recv_next);
+
+	*buf = g_buf;
+	*token = NULL;
+
+	return 0x1000;
+}
 
 DEFINE_RETURN_MOCK(spdk_sock_group_create, struct spdk_sock_group *);
 struct spdk_sock_group *
diff --git a/test/unit/lib/sock/sock.c/sock_ut.c b/test/unit/lib/sock/sock.c/sock_ut.c
index 951c02a3c..067d68234 100644
--- a/test/unit/lib/sock/sock.c/sock_ut.c
+++ b/test/unit/lib/sock/sock.c/sock_ut.c
@@ -1398,6 +1398,122 @@ posix_get_interface_name(void)
 	CU_ASSERT(rc == 0);
 }
 
+static int
+ut_recv_next(struct spdk_sock *sock, void **buf, struct spdk_sock_buf_token **token)
+{
+	return 0;
+}
+
+static int
+ut_release_buf(struct spdk_sock_group_impl *group, void *buf,
+	       struct spdk_sock_buf_token *token)
+{
+	return 0;
+}
+
+static void
+sock_impl_supports_recv_next(void)
+{
+	struct spdk_net_impl impl = {.name = "ut_recv_next"};
+	struct spdk_net_impl *saved_default = g_default_impl;
+
+	spdk_net_impl_register(&impl);
+	g_default_impl = &impl;
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(impl.name));
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(NULL));
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next("unknown_impl"));
+
+	impl.recv_next = ut_recv_next;
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(impl.name));
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(NULL));
+
+	impl.group_impl_release_buf = ut_release_buf;
+	CU_ASSERT(spdk_sock_impl_supports_recv_next(impl.name));
+	CU_ASSERT(spdk_sock_impl_supports_recv_next(NULL));
+
+	impl.recv_next = NULL;
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(impl.name));
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(NULL));
+
+	g_default_impl = NULL;
+	CU_ASSERT(!spdk_sock_impl_supports_recv_next(NULL));
+	g_default_impl = saved_default;
+	STAILQ_REMOVE(&g_net_impls, &impl, spdk_net_impl, link);
+}
+
+static int
+ut_owned_buf_release(struct spdk_sock_group_impl *group, void *buf,
+		     struct spdk_sock_buf_token *token)
+{
+	int *calls = buf;
+
+	CU_ASSERT(group == token->group_impl);
+	(*calls)++;
+	return 0;
+}
+
+static int
+ut_other_buf_release(struct spdk_sock_group_impl *group, void *buf,
+		     struct spdk_sock_buf_token *token)
+{
+	CU_FAIL("Buffer dispatched to the wrong implementation");
+	return -EIO;
+}
+
+static int
+ut_owned_buf_sock_close(struct spdk_sock_group_impl *group, struct spdk_sock *sock)
+{
+	free(sock);
+	return 0;
+}
+
+static void
+sock_group_release_owned_buf(void)
+{
+	struct spdk_sock_group group = {}, wrong_group = {};
+	struct spdk_net_impl owner_impl = {
+		.group_impl_release_buf = ut_owned_buf_release,
+		.close = ut_owned_buf_sock_close,
+	};
+	struct spdk_net_impl other_impl = {.group_impl_release_buf = ut_other_buf_release};
+	struct spdk_sock_group_impl owner = {.group = &group, .net_impl = &owner_impl};
+	struct spdk_sock_group_impl other = {.group = &group, .net_impl = &other_impl};
+	struct spdk_sock_buf_token token = {.group_impl = &owner};
+	struct spdk_sock_buf_token invalid_token = {};
+	struct spdk_sock *sock;
+	int calls = 0;
+
+	STAILQ_INIT(&group.group_impls);
+	STAILQ_INSERT_TAIL(&group.group_impls, &other, link);
+	STAILQ_INSERT_TAIL(&group.group_impls, &owner, link);
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&group, &calls, &token), 0);
+	CU_ASSERT_EQUAL(calls, 1);
+
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&wrong_group, &calls, &token), -EINVAL);
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(NULL, &calls, &token), -EINVAL);
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&group, &calls, NULL), -EINVAL);
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&group, &calls, &invalid_token), -EINVAL);
+	CU_ASSERT_EQUAL(calls, 1);
+
+	sock = calloc(1, sizeof(*sock));
+	SPDK_CU_ASSERT_FATAL(sock != NULL);
+	sock->net_impl = &owner_impl;
+	TAILQ_INIT(&sock->queued_reqs);
+	TAILQ_INIT(&sock->pending_reqs);
+	TAILQ_INIT(&owner.socks);
+	sock_group_impl_add_sock(&owner, sock);
+	CU_ASSERT_EQUAL(spdk_sock_close(&sock), 0);
+	CU_ASSERT(sock == NULL);
+	CU_ASSERT(TAILQ_EMPTY(&owner.socks));
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&group, &calls, &token), 0);
+	CU_ASSERT_EQUAL(calls, 2);
+
+	STAILQ_REMOVE(&group.group_impls, &other, spdk_sock_group_impl, link);
+	STAILQ_INSERT_TAIL(&group.group_impls, &other, link);
+	CU_ASSERT_EQUAL(spdk_sock_group_release_buf(&group, &calls, &token), 0);
+	CU_ASSERT_EQUAL(calls, 3);
+}
+
 struct ut_async_write_ctx {
 	int legacy_calls;
 	int ext_calls;
@@ -1519,6 +1635,8 @@ main(int argc, char **argv)
 	CU_ADD_TEST(suite, ut_sock_group_get_ctx);
 	CU_ADD_TEST(suite, posix_get_interface_name);
 	CU_ADD_TEST(suite, sock_writev_async_dispatch);
+	CU_ADD_TEST(suite, sock_impl_supports_recv_next);
+	CU_ADD_TEST(suite, sock_group_release_owned_buf);
 
 
 	num_failures = spdk_ut_run_tests(argc, argv, NULL);
