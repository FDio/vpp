 include/spdk/nvmf_transport.h | 21 ++++++++++++++-
 lib/nvmf/Makefile             |  2 +-
 lib/nvmf/auth.c               |  7 ++---
 lib/nvmf/ctrlr.c              | 50 ++++++++++++++++++-----------------
 lib/nvmf/ctrlr_bdev.c         | 28 ++++++++++++--------
 lib/nvmf/ctrlr_discovery.c    |  5 ++--
 lib/nvmf/subsystem.c          |  8 +++---
 lib/nvmf/transport.c          | 13 +++++----
 9 files changed, 89 insertions(+), 51 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index e8a69505e..2101e80d7 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -2,6 +2,12 @@
 
 ## v27.01: (Upcoming Release)
 
+### nvmf
+
+Added an optional transport-owned extended payload iovec to `struct spdk_nvmf_request` while
+retaining the existing inline array for the common case. This changes the size of the public
+request structure, so the nvmf library major SO version has been increased to 25.
+
 ## v26.09
 
 ### accel
diff --git a/include/spdk/nvmf_transport.h b/include/spdk/nvmf_transport.h
index 5ba0056cf..d4fa7795a 100644
--- a/include/spdk/nvmf_transport.h
+++ b/include/spdk/nvmf_transport.h
@@ -106,6 +106,13 @@ struct spdk_nvmf_request {
 	struct spdk_accel_sequence	*accel_sequence;
 
 	struct iovec			iov[NVMF_REQ_MAX_BUFFERS];
+	/*
+	 * Transports may provide a larger payload vector when the inline array is
+	 * too small.  Keeping the inline array preserves the allocation cost of
+	 * the common path; iov_ext is allocated only by transports that need it.
+	 */
+	struct iovec			*iov_ext;
+	uint16_t			iov_ext_capacity;
 
 	struct spdk_bdev_io_wait_entry	bdev_io_wait;
 	spdk_nvmf_nvme_passthru_cmd_cb	cmd_cb_fn;
@@ -126,11 +133,23 @@ struct spdk_nvmf_request {
 	union spdk_nvme_parameter_error_location	error_location;
 	STAILQ_ENTRY(spdk_nvmf_request)	reservation_link;
 };
+static inline struct iovec *
+spdk_nvmf_request_get_iov(struct spdk_nvmf_request *req)
+{
+	return req->iov_ext != NULL ? req->iov_ext : req->iov;
+}
+
+static inline uint16_t
+spdk_nvmf_request_get_iov_capacity(const struct spdk_nvmf_request *req)
+{
+	return req->iov_ext != NULL ? req->iov_ext_capacity : NVMF_REQ_MAX_BUFFERS;
+}
+
 /* The iov array grows by two iovecs for every additional SGL entry, so the
  * expected size can be derived from the size of the default configuration.
  */
 SPDK_STATIC_ASSERT(sizeof(struct spdk_nvmf_request) ==
-		   752 + (SPDK_NVMF_MAX_SGL_ENTRIES - 16) * 2 * sizeof(struct iovec),
+		   768 + (SPDK_NVMF_MAX_SGL_ENTRIES - 16) * 2 * sizeof(struct iovec),
 		   "Incorrect size");
 
