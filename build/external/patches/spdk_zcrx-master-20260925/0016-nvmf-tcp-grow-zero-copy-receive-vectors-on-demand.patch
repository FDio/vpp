+static int
+nvmf_tcp_req_ensure_zcopy_iov_capacity(struct spdk_nvmf_tcp_req *tcp_req,
+				       uint16_t required)
+{
+	struct spdk_nvmf_request *req = &tcp_req->req;
+	struct spdk_nvmf_tcp_stream_segment **segment_refs;
+	struct iovec *iovs;
+	uint16_t capacity;
+
+	capacity = spdk_nvmf_request_get_iov_capacity(req);
+	if (required <= capacity) {
+		return 0;
+	}
+
+	if (required > UINT8_MAX) {
+		return -ENOSPC;
+	}
+
+	while (capacity < required) {
+		capacity = spdk_min((uint16_t)(capacity * 2), (uint16_t)UINT8_MAX);
+	}
+
+	iovs = calloc(capacity, sizeof(*iovs));
+	segment_refs = calloc(capacity, sizeof(*segment_refs));
+	if (iovs == NULL || segment_refs == NULL) {
+		free(iovs);
+		free(segment_refs);
+		return -ENOMEM;
+	}
+
+	memcpy(iovs, nvmf_tcp_req_iovs(tcp_req), req->iovcnt * sizeof(*iovs));
+	memcpy(segment_refs, tcp_req->segment_refs,
+	       tcp_req->segment_cnt * sizeof(*segment_refs));
+
+	free(req->iov_ext);
+	free(tcp_req->segment_refs_ext);
+	req->iov_ext = iovs;
+	req->iov_ext_capacity = capacity;
+	tcp_req->segment_refs = segment_refs;
+	tcp_req->segment_refs_ext = segment_refs;
+
+	return 0;
+}
+
+static int
+nvmf_tcp_pdu_ensure_zcopy_iov_capacity(struct nvme_tcp_pdu *pdu, uint16_t required)
+{
+	struct iovec *iovs;
+	uint16_t capacity;
+
+	capacity = nvme_tcp_pdu_get_data_iov_capacity(pdu);
+	if (required <= capacity) {
+		return 0;
+	}
+
+	if (required > UINT8_MAX) {
+		return -ENOSPC;
+	}
+
+	while (capacity < required) {
+		capacity = spdk_min((uint16_t)(capacity * 2), (uint16_t)UINT8_MAX);
+	}
+
+	iovs = calloc(capacity, sizeof(*iovs));
+	if (iovs == NULL) {
+		return -ENOMEM;
+	}
+
+	memcpy(iovs, nvmf_tcp_pdu_data_iovs(pdu), pdu->data_iovcnt * sizeof(*iovs));
+	free(pdu->data_iov_ext);
+	pdu->data_iov_ext = iovs;
+	pdu->data_iov_ext_capacity = capacity;
+
+	return 0;
+}
+
+static int
+nvmf_tcp_double_buffer_request_payload(struct spdk_nvmf_tcp_qpair *tqpair,
+				       struct spdk_nvmf_tcp_req *tcp_req, struct nvme_tcp_pdu *pdu)
+{
+	struct spdk_nvmf_tcp_stream_segment *segment;
+	struct iovec *pdu_iovs, *req_iovs;
+	size_t total_sz = 0;
+	void *double_buf;
+	uint16_t i, iovcnt;
+	size_t copy_offset;
+
+	iovcnt = tcp_req->req.iovcnt;
+	if (iovcnt == 0) {
+		return -ENOSPC;
+	}
+
+	assert(tcp_req->segment_refs != NULL);
+	assert(tcp_req->segment_cnt == iovcnt);
+	req_iovs = nvmf_tcp_req_iovs(tcp_req);
+	for (i = 0; i < iovcnt; i++) {
+		total_sz += req_iovs[i].iov_len;
+	}
+
+	SPDK_WARNLOG("Double buffering scattered zero-copy request on tqpair=%p\n", tqpair);
+	double_buf = spdk_malloc(total_sz, PAGE_SIZE, NULL, SPDK_ENV_SOCKET_ID_ANY,
+				 SPDK_MALLOC_DMA);
+	if (double_buf == NULL) {
+		SPDK_ERRLOG("Failed to allocate buffer for scattered request\n");
+		return -ENOMEM;
+	}
+
+	copy_offset = 0;
+	for (i = 0; i < iovcnt; i++) {
+		memcpy((uint8_t *)double_buf + copy_offset, req_iovs[i].iov_base,
+		       req_iovs[i].iov_len);
+		copy_offset += req_iovs[i].iov_len;
+
+		segment = tcp_req->segment_refs[i];
+		if (segment == NULL) {
+			spdk_free(req_iovs[i].iov_base);
+		} else {
+			nvmf_tcp_segment_put(tqpair, segment);
+		}
+	}
+
+	memset(req_iovs, 0, iovcnt * sizeof(*req_iovs));
+	memset(tcp_req->segment_refs, 0,
+	       tcp_req->segment_cnt * sizeof(*tcp_req->segment_refs));
+
+	/* The current PDU iovecs are a trailing subset of the request iovecs
+	 * materialized above. Do not retain pointers to their released segments. */
+	pdu_iovs = nvmf_tcp_pdu_data_iovs(pdu);
+	memset(pdu_iovs, 0, pdu->data_iovcnt * sizeof(*pdu_iovs));
+	nvmf_tcp_pdu_reset_data_iovs(pdu);
+
+	req_iovs[0].iov_base = double_buf;
+	req_iovs[0].iov_len = total_sz;
+	tcp_req->req.iovcnt = 1;
+
+	/* A null entry is a signal that this was double buffered. */
+	tcp_req->segment_refs[0] = NULL;
+	tcp_req->segment_cnt = 1;
+
+	return 0;
+}
