+static void
+test_nvmf_tcp_qpair_destroy_partial_resources(void)
+{
+	struct spdk_nvmf_tcp_qpair *tqpair;
+	uint32_t resource_count = 2;
+
+	/* Requests may be allocated before the PDU array allocation fails. */
+	tqpair = calloc(1, sizeof(*tqpair));
+	SPDK_CU_ASSERT_FATAL(tqpair != NULL);
+	tqpair->resource_count = resource_count;
+	tqpair->state_cntr[TCP_REQUEST_STATE_FREE] = resource_count;
+	tqpair->reqs = calloc(resource_count, sizeof(*tqpair->reqs));
+	SPDK_CU_ASSERT_FATAL(tqpair->reqs != NULL);
+	tqpair->reqs[0].req.iov_ext = calloc(1, sizeof(struct iovec));
+	tqpair->reqs[0].segment_refs_ext = calloc(1, sizeof(*tqpair->reqs[0].segment_refs_ext));
+	_nvmf_tcp_qpair_destroy(tqpair);
+
+	/* Keep the inverse partial state covered as well. */
+	tqpair = calloc(1, sizeof(*tqpair));
+	SPDK_CU_ASSERT_FATAL(tqpair != NULL);
+	tqpair->resource_count = resource_count;
+	tqpair->state_cntr[TCP_REQUEST_STATE_FREE] = resource_count;
+	tqpair->pdus = spdk_dma_zmalloc((2 * resource_count + 1) * sizeof(*tqpair->pdus),
+					0x1000, NULL);
+	SPDK_CU_ASSERT_FATAL(tqpair->pdus != NULL);
+	tqpair->pdus[0].data_iov_ext = calloc(1, sizeof(struct iovec));
+	_nvmf_tcp_qpair_destroy(tqpair);
+}
