+static void
+test_nvmf_tcp_read_data_zcopy_inter_pdu_fallback(void)
+{
+	struct spdk_nvmf_tcp_stream_segment segments[UINT8_MAX] = {};
+	struct spdk_nvmf_tcp_stream_segment *segment_refs[UINT8_MAX] = {};
+	struct spdk_nvmf_tcp_poll_group tgroup = {};
+	struct spdk_nvmf_tcp_qpair tqpair = {};
+	struct spdk_nvmf_tcp_req tcp_req = {};
+	struct nvme_tcp_pdu pdu = {};
+	struct iovec request_iovs[UINT8_MAX] = {};
+	uint8_t existing_data[UINT8_MAX - 1] = {};
+	uint8_t pending_data = 0xa5;
+	void *previous_double_buf;
+	uint32_t initial_segments, i;
+	int rc;
+
+	/* Previous H2C PDUs consumed all but one request iovec. The new PDU
+	 * must reclaim those request vectors before retaining its first segment. */
+	initial_segments = UINT8_MAX - 1;
+
+	STAILQ_INIT(&tgroup.free_segments);
+	STAILQ_INIT(&tqpair.pending_stream);
+	tgroup.sock_group = (struct spdk_sock_group *)0x1;
+	tqpair.group = &tgroup;
+	tcp_req.segment_refs = segment_refs;
+	tcp_req.req.iov_ext = request_iovs;
+	tcp_req.req.iov_ext_capacity = SPDK_COUNTOF(request_iovs);
+
+	for (i = 0; i < initial_segments; i++) {
+		existing_data[i] = (uint8_t)i;
+		request_iovs[i].iov_base = &existing_data[i];
+		request_iovs[i].iov_len = 1;
+		segments[i].buf = &existing_data[i];
+		segments[i].len = 1;
+		segments[i].refcnt = 1;
+		segment_refs[i] = &segments[i];
+	}
+	/* Also cover a buffer materialized by an earlier fallback. */
+	previous_double_buf = spdk_malloc(1, PAGE_SIZE, NULL, SPDK_ENV_SOCKET_ID_ANY,
+					  SPDK_MALLOC_DMA);
+	SPDK_CU_ASSERT_FATAL(previous_double_buf != NULL);
+	*(uint8_t *)previous_double_buf = existing_data[0];
+	request_iovs[0].iov_base = previous_double_buf;
+	segment_refs[0] = NULL;
+	segments[0].refcnt = 0;
+	tcp_req.req.iovcnt = initial_segments;
+	tcp_req.segment_cnt = initial_segments;
+
+	segments[initial_segments].buf = &pending_data;
+	segments[initial_segments].len = 1;
+	segments[initial_segments].refcnt = 1;
+	STAILQ_INSERT_TAIL(&tqpair.pending_stream, &segments[initial_segments], link);
+
+	pdu.data_len = sizeof(pending_data);
+	rc = nvmf_tcp_read_data_zcopy(&tqpair, &tcp_req, &pdu);
+
+	CU_ASSERT(rc == (int)sizeof(pending_data));
+	CU_ASSERT(STAILQ_EMPTY(&tqpair.pending_stream));
+	CU_ASSERT(tcp_req.req.iovcnt == 2);
+	CU_ASSERT(tcp_req.segment_cnt == 2);
+	CU_ASSERT(tcp_req.segment_refs[0] == NULL);
+	CU_ASSERT(tcp_req.segment_refs[1] == &segments[initial_segments]);
+	CU_ASSERT(request_iovs[0].iov_len == initial_segments);
+	CU_ASSERT(memcmp(request_iovs[0].iov_base, existing_data,
+			 initial_segments) == 0);
+	CU_ASSERT(request_iovs[1].iov_base == &pending_data);
+	CU_ASSERT(pdu.data_iovcnt == 1);
+	CU_ASSERT(pdu.data_iov[0].iov_base == &pending_data);
+	for (i = 0; i < initial_segments; i++) {
+		CU_ASSERT(segments[i].refcnt == 0);
+	}
+	CU_ASSERT(segments[initial_segments].refcnt == 1);
+
+	spdk_free(request_iovs[0].iov_base);
+	nvmf_tcp_segment_put(&tqpair, tcp_req.segment_refs[1]);
+}
