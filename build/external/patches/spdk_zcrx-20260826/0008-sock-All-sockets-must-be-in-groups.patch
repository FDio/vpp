+static struct spdk_sock_group *
+nvme_tcp_qpair_get_sock_group(struct spdk_nvme_qpair *qpair)
+{
+	struct nvme_tcp_poll_group *tgroup;
+	struct spdk_sock_group *sock_group;
+	struct spdk_sock_group_opts opts = {
+		.size = sizeof(opts),
+		.ctx = NULL,
+		.rx_cb = nvme_tcp_qpair_no_group_sock_cb,
+	};
+
+	if (qpair->poll_group) {
+		tgroup = nvme_tcp_poll_group(qpair->poll_group);
+		return tgroup->sock_group;
+	}
+
+	if (nvme_qpair_is_admin_queue(qpair)) {
+		/* Admin qpair polling is serialized by the controller lock, so admin qpairs can
+		 * share one internal socket group instead of allocating a group per controller.
+		 */
+		pthread_once(&g_admin_poll_group_mutex_once, nvme_tcp_admin_poll_group_mutex_init);
+		pthread_mutex_lock(&g_admin_poll_group_mutex);
+		if (g_admin_poll_group == NULL) {
