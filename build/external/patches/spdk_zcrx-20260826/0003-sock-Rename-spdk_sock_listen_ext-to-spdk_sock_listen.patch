From 8410c4933d3db919b4d7e61720a14d53fd210daf Mon Sep 17 00:00:00 2001
From: Ben Walker <ben@nvidia.com>
Date: Fri, 9 Aug 2024 10:22:49 -0700
Subject: [PATCH 03/21] sock: Rename spdk_sock_listen_ext to spdk_sock_listen

We are breaking the API, so let's take care of some renames while we
have the chance.

Change-Id: I6937079bd7d135635e70eb096b08a6cbe6aa7e5e
Signed-off-by: Ben Walker <ben@nvidia.com>
---
 deprecation.md                         |  4 ----
 examples/sock/hello_world/hello_sock.c |  2 +-
 include/spdk/sock.h                    | 19 +++----------------
 lib/iscsi/portal_grp.c                 |  6 +++++-
 lib/nvmf/tcp.c                         |  4 ++--
 lib/sock/sock.c                        | 12 +-----------
 lib/sock/spdk_sock.map                 |  1 -
 test/common/lib/test_sock.c            |  4 +---
 test/unit/lib/sock/sock.c/sock_ut.c    | 14 +++++++-------
 9 files changed, 20 insertions(+), 46 deletions(-)

diff --git a/deprecation.md b/deprecation.md
index 0064a9b18..e9bd0b396 100644
--- a/deprecation.md
+++ b/deprecation.md
@@ -118,10 +118,6 @@ The `cb_fn` and `cb_arg` parameters of `spdk_sock_group_add_sock` are deprecated
 removed in v26.09. Instead, pass `cb_fn` and `cb_arg` via the new `spdk_sock_group_opts` struct
 passed to `spdk_sock_group_create`.
 
-#### `spdk_sock_listen`, `spdk_sock_listen_ext`
-
-These two APIs will be collapsed into a single replacement starting in v26.09.
-
 #### `nvmf_create_transport`
 
 buf-cache-size parameter is deprecated in favor of iobuf-small-cache-size and will be removed in 26.09 release.
diff --git a/examples/sock/hello_world/hello_sock.c b/examples/sock/hello_world/hello_sock.c
index 3c317cc72..b359b1ab9 100644
--- a/examples/sock/hello_world/hello_sock.c
+++ b/examples/sock/hello_world/hello_sock.c
@@ -507,7 +507,7 @@ hello_sock_listen(struct hello_context_t *ctx)
 	opts.impl_opts = &impl_opts;
 	opts.impl_opts_size = sizeof(impl_opts);
 
-	ctx->sock = spdk_sock_listen_ext(ctx->host, ctx->port, ctx->sock_impl_name, &opts);
+	ctx->sock = spdk_sock_listen(ctx->host, ctx->port, ctx->sock_impl_name, &opts);
 	if (ctx->sock == NULL) {
 		SPDK_ERRLOG("Cannot create server socket\n");
 		spdk_sock_group_close(&ctx->group);
