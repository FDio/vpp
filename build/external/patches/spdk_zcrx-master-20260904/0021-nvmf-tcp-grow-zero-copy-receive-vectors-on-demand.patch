+static int
+nvmf_tcp_req_ensure_zcopy_iov_capacity(struct spdk_nvmf_tcp_req *tcp_req,
+		uint16_t required)
+{
+	struct spdk_nvmf_request *req = &tcp_req->req;
+	struct spdk_nvmf_tcp_stream_segment **segment_refs;
+	struct iovec *iovs;
+	uint16_t capacity;
+
+	capacity = spdk_nvmf_request_get_iov_capacity(req);
+	if (required <= capacity) {
+		return 0;
+	}
+
+	if (required > UINT8_MAX) {
+		return -ENOSPC;
+	}
+
+	while (capacity < required) {
+		capacity = spdk_min((uint16_t)(capacity * 2), (uint16_t)UINT8_MAX);
+	}
+
+	iovs = calloc(capacity, sizeof(*iovs));
+	segment_refs = calloc(capacity, sizeof(*segment_refs));
+	if (iovs == NULL || segment_refs == NULL) {
+		free(iovs);
+		free(segment_refs);
+		return -ENOMEM;
+	}
+
+	memcpy(iovs, nvmf_tcp_req_iovs(tcp_req), req->iovcnt * sizeof(*iovs));
+	memcpy(segment_refs, tcp_req->segment_refs,
+	       tcp_req->segment_cnt * sizeof(*segment_refs));
+
+	free(req->iov_ext);
+	free(tcp_req->segment_refs_ext);
+	req->iov_ext = iovs;
+	req->iov_ext_capacity = capacity;
+	tcp_req->segment_refs = segment_refs;
+	tcp_req->segment_refs_ext = segment_refs;
+
+	return 0;
+}
+
+static int
+nvmf_tcp_pdu_ensure_zcopy_iov_capacity(struct nvme_tcp_pdu *pdu, uint16_t required)
+{
+	struct iovec *iovs;
+	uint16_t capacity;
+
+	capacity = nvme_tcp_pdu_get_data_iov_capacity(pdu);
+	if (required <= capacity) {
+		return 0;
+	}
+
+	if (required > UINT8_MAX) {
+		return -ENOSPC;
+	}
+
+	while (capacity < required) {
+		capacity = spdk_min((uint16_t)(capacity * 2), (uint16_t)UINT8_MAX);
+	}
+
+	iovs = calloc(capacity, sizeof(*iovs));
+	if (iovs == NULL) {
+		return -ENOMEM;
+	}
+
+	memcpy(iovs, nvmf_tcp_pdu_data_iovs(pdu), pdu->data_iovcnt * sizeof(*iovs));
+	free(pdu->data_iov_ext);
+	pdu->data_iov_ext = iovs;
+	pdu->data_iov_ext_capacity = capacity;
+
+	return 0;
+}
