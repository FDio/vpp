+static void
+test_nvmf_tcp_rx_pool_exhausted(void)
+{
+	struct spdk_nvmf_tcp_poll_group tgroup = {};
+	struct spdk_nvmf_tcp_transport ttransport = {};
+	struct spdk_nvmf_tcp_qpair tqpair = {};
+	struct spdk_nvmf_tcp_req tcp_req = {};
+	struct nvme_tcp_pdu pdu = {};
+	struct spdk_nvmf_tcp_stream_segment *held[SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP];
+	struct spdk_nvmf_tcp_stream_segment *refs[NVMF_REQ_MAX_BUFFERS] = {};
+	struct spdk_nvmf_tcp_stream_segment *segment;
+	uint32_t i;
+
+	STAILQ_INIT(&tgroup.free_segments);
+	STAILQ_INIT(&tqpair.pending_stream);
+	tgroup.sock_group = (struct spdk_sock_group *)0x1;
+	tqpair.group = &tgroup;
+	tqpair.sock = (struct spdk_sock *)0x1;
+	tqpair.use_zero_copy_rx = true;
+	tqpair.qpair.transport = &ttransport.transport;
+	tqpair.recv_state = NVME_TCP_PDU_RECV_STATE_AWAIT_PDU_PAYLOAD;
+	tqpair.pdu_in_progress = &pdu;
+	tqpair.tcp_pdu_working_count = 1;
+	tcp_req.state = TCP_REQUEST_STATE_AWAITING_R2T_ACK;
+	tcp_req.segment_refs = refs;
+	pdu.req = &tcp_req;
+	pdu.hdr.common.pdu_type = SPDK_NVME_TCP_PDU_TYPE_H2C_DATA;
+	pdu.data_len = sizeof(g_buf) * SPDK_COUNTOF(held);
+	tcp_req.req.length = pdu.data_len;
+	ttransport.transport.opts.max_io_size = pdu.data_len;
+
+	/* Other incomplete requests retain every descriptor in the initial pool. */
+	for (i = 0; i < SPDK_COUNTOF(held); i++) {
+		held[i] = calloc(1, sizeof(*held[i]));
+		SPDK_CU_ASSERT_FATAL(held[i] != NULL);
+		held[i]->refcnt = 1;
+		tgroup.stream_segment_count++;
+	}
+
+	memset(g_buf, 0xa5, sizeof(g_buf));
+	nvmf_tcp_qpair_process(&tqpair);
+	/* The full payload arrives even though other requests retain the pool.
+	 * Waiting for R2T acknowledgement keeps it from backend submission. */
+	CU_ASSERT(tcp_req.h2c_offset == tcp_req.req.length);
+	CU_ASSERT(tcp_req.state == TCP_REQUEST_STATE_AWAITING_R2T_ACK);
+	CU_ASSERT(tgroup.stream_segment_count == 2 * SPDK_COUNTOF(held));
+	CU_ASSERT(STAILQ_EMPTY(&tqpair.pending_stream));
+	for (i = 0; i < tcp_req.req.iovcnt; i++) {
+		CU_ASSERT(*(uint8_t *)nvmf_tcp_req_iovs(&tcp_req)[i].iov_base == 0xa5);
+		if (tcp_req.segment_refs[i] == NULL) {
+			spdk_free(nvmf_tcp_req_iovs(&tcp_req)[i].iov_base);
+		} else {
+			nvmf_tcp_segment_put(&tqpair, tcp_req.segment_refs[i]);
+		}
+	}
+	for (i = 0; i < SPDK_COUNTOF(held); i++) {
+		nvmf_tcp_segment_put(&tqpair, held[i]);
+	}
+	while (!STAILQ_EMPTY(&tgroup.free_segments)) {
+		segment = STAILQ_FIRST(&tgroup.free_segments);
+		STAILQ_REMOVE_HEAD(&tgroup.free_segments, link);
+		CU_ASSERT(segment->refcnt == 0);
+		free(segment);
+	}
+	free(tcp_req.req.iov_ext);
+	free(tcp_req.segment_refs_ext);
+	free(pdu.data_iov_ext);
+	memset(g_buf, 0, sizeof(g_buf));
+}
+
+static void
+test_nvmf_tcp_pending_stream_bound(void)
+{
+	struct spdk_nvmf_tcp_poll_group tgroup = {};
+	struct spdk_nvmf_tcp_transport ttransport = {};
+	struct spdk_nvmf_tcp_qpair tqpair = {};
+	struct nvme_tcp_pdu pdu = {};
+	struct spdk_nvmf_tcp_stream_segment *segment;
+	uint32_t i, count = 0;
+
+	STAILQ_INIT(&tgroup.free_segments);
+	STAILQ_INIT(&tqpair.pending_stream);
+	tqpair.group = &tgroup;
+	tqpair.use_zero_copy_rx = true;
+	tqpair.qpair.transport = &ttransport.transport;
+	tqpair.recv_state = NVME_TCP_PDU_RECV_STATE_AWAIT_PDU_BUF;
+	tqpair.pdu_in_progress = &pdu;
+
+	for (i = 0; i < SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP + 1; i++) {
+		segment = calloc(1, sizeof(*segment));
+		SPDK_CU_ASSERT_FATAL(segment != NULL);
+		if (i == 0) {
+			segment->refcnt = 1;
+			STAILQ_INSERT_TAIL(&tqpair.pending_stream, segment, link);
+		} else {
+			STAILQ_INSERT_HEAD(&tgroup.free_segments, segment, link);
+		}
+	}
+
+	/* A blocked parser must not keep accumulating receive batches. */
+	for (i = 0; i < 20; i++) {
+		nvmf_tcp_qpair_process(&tqpair);
+	}
+	STAILQ_FOREACH(segment, &tqpair.pending_stream, link) {
+		count++;
+	}
+	CU_ASSERT(count == 1);
+
+	nvmf_tcp_pending_stream_drain(&tqpair);
+	while (!STAILQ_EMPTY(&tgroup.free_segments)) {
+		segment = STAILQ_FIRST(&tgroup.free_segments);
+		STAILQ_REMOVE_HEAD(&tgroup.free_segments, link);
+		CU_ASSERT(segment->refcnt == 0);
+		free(segment);
+	}
+}
+
+static void
+test_nvmf_tcp_rx_tracker_allocation_failure(void)
+{
+	struct spdk_nvmf_tcp_poll_group tgroup = {};
+	struct spdk_nvmf_tcp_transport ttransport = {};
+	struct spdk_nvmf_tcp_qpair tqpair = {};
+	struct nvme_tcp_pdu pdu = {};
+	struct spdk_nvmf_tcp_stream_segment *segment;
+
+	STAILQ_INIT(&tgroup.free_segments);
+	STAILQ_INIT(&tqpair.pending_stream);
+	tqpair.group = &tgroup;
+	tqpair.use_zero_copy_rx = true;
+	tqpair.qpair.transport = &ttransport.transport;
+	tqpair.state = NVMF_TCP_QPAIR_STATE_RUNNING;
+	tqpair.recv_state = NVME_TCP_PDU_RECV_STATE_AWAIT_PDU_PAYLOAD;
+	tqpair.pdu_in_progress = &pdu;
+	tqpair.tcp_pdu_working_count = 1;
+	g_qpair_disconnect_count = 0;
+
+	MOCK_SET(calloc, NULL);
+	nvmf_tcp_qpair_process(&tqpair);
+	MOCK_CLEAR(calloc);
+	CU_ASSERT(g_qpair_disconnect_count == 0);
+	CU_ASSERT(STAILQ_EMPTY(&tqpair.pending_stream));
+	CU_ASSERT(tgroup.stream_segment_count == 0);
+
+	/* Retry once memory is available, without dropping the connection. */
+	nvmf_tcp_qpair_process(&tqpair);
+	CU_ASSERT(g_qpair_disconnect_count == 0);
+	CU_ASSERT(!STAILQ_EMPTY(&tqpair.pending_stream));
+	CU_ASSERT(tgroup.stream_segment_count == SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP);
+	nvmf_tcp_pending_stream_drain(&tqpair);
+	while (!STAILQ_EMPTY(&tgroup.free_segments)) {
+		segment = STAILQ_FIRST(&tgroup.free_segments);
+		STAILQ_REMOVE_HEAD(&tgroup.free_segments, link);
+		free(segment);
+	}
+}
+
+static void
+test_nvmf_tcp_rx_pool_partial_cleanup(void)
+{
+	struct spdk_nvmf_tcp_poll_group *tgroup;
+	struct spdk_nvmf_tcp_stream_segment *segment;
+	uint32_t i;
+
+	tgroup = calloc(1, sizeof(*tgroup));
+	SPDK_CU_ASSERT_FATAL(tgroup != NULL);
+	STAILQ_INIT(&tgroup->free_segments);
+	for (i = 0; i < 3; i++) {
+		segment = calloc(1, sizeof(*segment));
+		SPDK_CU_ASSERT_FATAL(segment != NULL);
+		STAILQ_INSERT_HEAD(&tgroup->free_segments, segment, link);
+		tgroup->stream_segment_count++;
+	}
+	/* A failed create has not yet assigned group.transport. ASan checks
+	 * that its partially initialized descriptor pool is still freed. */
+	nvmf_tcp_poll_group_destroy(&tgroup->group);
+}
