From 8aae4264c35b134e352de03e83b7ec78b9a61958 Mon Sep 17 00:00:00 2001
From: Jerome Tollet <jtollet@cisco.com>
Date: Sat, 24 Oct 2026 15:51:50 +0200
Subject: [PATCH 10/10] nvmf/tcp: avoid receive stream tracker starvation

Incomplete zero-copy requests can retain all 1024 stream descriptors
in a poll group. No qpair can then receive the remaining payload needed
to complete those requests and return their descriptors to the pool.

Grow the descriptor cache when it is exhausted, retaining the existing
1024-segment receive budget per callback. Do not acquire another batch
while an earlier batch remains queued behind a blocked parser. Retry
allocation failures as receive backpressure without closing a connection
whose PDU may still be incomplete.

Track the allocated descriptor count for teardown diagnostics and free
the cache when poll group creation fails partway through initialization.

Add regressions for receiving a complete payload with the initial pool
retained by other requests, a blocked parser with queued stream data,
recovery after a temporary descriptor allocation failure, and cleanup
of a partially initialized poll group.

Validation: NVMf, socket and NVMe/TCP unit suites with Clang, ASan,
UBSan and leak detection. Negative controls verify each regression and
restore the original source before rerunning the complete TCP suite.

Change-Id: I3a921e3906d7b0bfe6d4aca4194cc325f8e79566
Signed-off-by: Jerome Tollet <jtollet@cisco.com>
---
 lib/nvmf/tcp.c                    |  63 +++++++---
 test/unit/lib/nvmf/tcp.c/tcp_ut.c | 190 +++++++++++++++++++++++++++++-
 2 files changed, 234 insertions(+), 19 deletions(-)

diff --git a/lib/nvmf/tcp.c b/lib/nvmf/tcp.c
index 638ae64e7..e72af4fac 100644
--- a/lib/nvmf/tcp.c
+++ b/lib/nvmf/tcp.c
@@ -395,6 +395,7 @@ struct spdk_nvmf_tcp_poll_group {
 	struct spdk_interrupt			*intr;
 
 	STAILQ_HEAD(, spdk_nvmf_tcp_stream_segment) free_segments;
+	uint32_t				stream_segment_count;
 
 	TAILQ_HEAD(, spdk_nvmf_tcp_qpair)	qpairs;
 
@@ -673,6 +674,25 @@ nvmf_tcp_dump_qpair_req_contents(struct spdk_nvmf_tcp_qpair *tqpair)
 	}
 }
 
+static struct spdk_nvmf_tcp_stream_segment *
+nvmf_tcp_segment_get(struct spdk_nvmf_tcp_poll_group *tgroup)
+{
+	struct spdk_nvmf_tcp_stream_segment *segment;
+
+	segment = STAILQ_FIRST(&tgroup->free_segments);
+	if (segment == NULL) {
+		/* Incomplete requests can retain the whole initial pool. Receiving
+		 * their remaining payload must not depend on a free descriptor. */
+		segment = calloc(1, sizeof(*segment));
+		if (segment != NULL) {
+			tgroup->stream_segment_count++;
+			STAILQ_INSERT_HEAD(&tgroup->free_segments, segment, link);
+		}
+	}
+
+	return segment;
+}
+
 static void
 nvmf_tcp_segment_put(struct spdk_nvmf_tcp_qpair *tqpair,
 		     struct spdk_nvmf_tcp_stream_segment *segment)
@@ -1854,6 +1874,7 @@ nvmf_tcp_poll_group_create(struct spdk_nvmf_transport *transport,
 		}
 
 		STAILQ_INSERT_HEAD(&tgroup->free_segments, segment, link);
+		tgroup->stream_segment_count++;
 	}
 
 	return &tgroup->group;
@@ -1905,7 +1926,8 @@ nvmf_tcp_poll_group_destroy(struct spdk_nvmf_transport_poll_group *group)
 {
 	struct spdk_nvmf_tcp_poll_group *tgroup, *next_tgroup;
 	struct spdk_nvmf_tcp_transport *ttransport;
-	int rc, count;
+	int rc;
+	uint32_t count;
 	struct spdk_nvmf_tcp_stream_segment *segment, *tsegment;
 
 	tgroup = SPDK_CONTAINEROF(group, struct spdk_nvmf_tcp_poll_group, group);
@@ -1924,6 +1946,18 @@ nvmf_tcp_poll_group_destroy(struct spdk_nvmf_transport_poll_group *group)
 		spdk_put_io_channel(tgroup->accel_channel);
 	}
 
+	count = 0;
+	STAILQ_FOREACH_SAFE(segment, &tgroup->free_segments, link, tsegment) {
+		count++;
+		STAILQ_REMOVE_HEAD(&tgroup->free_segments, link);
+		free(segment);
+	}
+
+	if (count != tgroup->stream_segment_count) {
+		SPDK_ERRLOG("tgroup=%p free_segments count is %u but should be %u\n", tgroup, count,
+			    tgroup->stream_segment_count);
+	}
+
 	if (tgroup->group.transport == NULL) {
 		/* Transport can be NULL when nvmf_tcp_poll_group_create()
 		 * calls this function directly in a failure path. */
@@ -1942,18 +1976,6 @@ nvmf_tcp_poll_group_destroy(struct spdk_nvmf_transport_poll_group *group)
 		ttransport->next_pg = next_tgroup;
 	}
 
-	count = 0;
-	STAILQ_FOREACH_SAFE(segment, &tgroup->free_segments, link, tsegment) {
-		count++;
-		STAILQ_REMOVE_HEAD(&tgroup->free_segments, link);
-		free(segment);
-	}
-
-	if (count != SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP) {
-		SPDK_ERRLOG("tgroup=%p free_segments count is %u but should be %u\n", tgroup, count,
-			    SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP);
-	}
-
 	free(tgroup);
 }
 
@@ -3922,12 +3944,18 @@ nvmf_tcp_qpair_process(struct spdk_nvmf_tcp_qpair *tqpair)
 	int rc;
 	int count = 0;
 
-	if (tqpair->use_zero_copy_rx) {
+	/* Leave queued data in the socket while the parser is blocked on an
+	 * earlier batch, for example when all request slots are in use. */
+	if (tqpair->use_zero_copy_rx && STAILQ_EMPTY(&tqpair->pending_stream)) {
 		tgroup = tqpair->group;
 
-		/* First, acquire a segment tracker. */
-		segment = STAILQ_FIRST(&tgroup->free_segments);
-		while (segment != NULL && count < SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP) {
+		while (count < SPDK_NVMF_TCP_DEFAULT_STREAM_SEGMENTS_PER_POLL_GROUP) {
+			segment = nvmf_tcp_segment_get(tgroup);
+			if (segment == NULL) {
+				/* Apply the same backpressure as recv_next's -ENOBUFS. */
+				break;
+			}
+
 			/* Now try to grab the next portion of the TCP stream */
 			rc = spdk_sock_recv_next(tqpair->sock, &segment->buf, &segment->token);
 			if (rc < 0) {
@@ -3949,7 +3977,6 @@ nvmf_tcp_qpair_process(struct spdk_nvmf_tcp_qpair *tqpair)
 			STAILQ_INSERT_TAIL(&tqpair->pending_stream, segment, link);
 
 			count++;
-			segment = STAILQ_FIRST(&tgroup->free_segments);
 		}
 	}
 
