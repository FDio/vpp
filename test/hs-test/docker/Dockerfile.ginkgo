# set per run by script/build-images.sh; the default keeps 'docker build' working
ARG BASE_TAG=localhost:5001/vpp-test-base:latest
FROM ${BASE_TAG}

# We don't need to install these packages as they're in the base image
# Just install anything specific to VPP that isn't in the base

ARG UBUNTU_VERSION
ARG TARGETARCH
ARG CODENAME
ARG GO_VERSION
RUN --mount=type=cache,target=/tmp/cache \
  wget -t 2 "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -O /tmp/cache/go.tar.gz \
  && tar -xzf /tmp/cache/go.tar.gz -C /usr/local

RUN --mount=type=cache,target=/tmp/cache \
  wget -t 2 "https://download.docker.com/linux/ubuntu/dists/${CODENAME}/pool/stable/${TARGETARCH}/docker-ce-cli_29.3.1-1~ubuntu.${UBUNTU_VERSION}~${CODENAME}_${TARGETARCH}.deb" \
  -O /tmp/cache/docker-ce-cli.deb \
  && dpkg -i /tmp/cache/docker-ce-cli.deb

RUN ln -s /usr/local/go/bin/go /usr/bin/go

COPY go.mod go.sum /
RUN go mod download
