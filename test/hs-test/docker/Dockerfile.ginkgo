# set per run by script/build-images.sh; the default keeps 'docker build' working
ARG BASE_TAG=localhost:5001/vpp-test-base:latest
FROM ${BASE_TAG}

# We don't need to install these packages as they're in the base image
# Just install anything specific to VPP that isn't in the base

ARG UBUNTU_VERSION
ARG TARGETARCH
ARG CODENAME
ARG GO_VERSION
RUN --mount=type=bind,source=script/install_go.sh,target=/tmp/install_go.sh \
    --mount=type=cache,target=/var/cache/downloads \
    /tmp/install_go.sh

RUN --mount=type=bind,source=script/install_docker_ce_cli.sh,target=/tmp/install_docker_ce_cli.sh \
    --mount=type=cache,target=/var/cache/downloads \
    /tmp/install_docker_ce_cli.sh

COPY go.mod go.sum /
RUN go mod download
